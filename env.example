# Telegram Bot API Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# TDLib API Credentials (required for local server)
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Optional: Custom API URL (leave empty to use official api.telegram.org)
# When using docker-compose, this will be set automatically
TELEGRAM_API_URL= 
